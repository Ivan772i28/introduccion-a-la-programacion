Algoritmo sin_titulo
	Escribir "ingresar monto  de los productos "
	Leer costo_total
	descuento=costo_total*0.05
	subtotal=costo_total-descuento
	iva= subtotal*0.16	
	pago_definitivo= subtotal+iva
	Escribir "Monto total:  $",costo_total
	Escribir "Descuento  -",descuento
	Escribir "---------------------------------------------"
	Escribir "Subtotal:  ",subtotal
	Escribir "IVA:  ",iva
	Escribir "---------------------------------------------"
	Escribir "pago definitivo  $",pago_definitivo
FinAlgoritmo
