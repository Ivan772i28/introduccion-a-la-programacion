Algoritmo sin_titulo
	Escribir "Ingresa el valor 1:"
	Leer n1
	Escribir "Ingresa el valor 2:"
	Leer n2
	Escribir "Ingresa el valor 3:"
	Leer n3
	Escribir "Ingresa el valor 4:"
	Leer n4
	suma=n1+n2+n3+n4
	multiplicacion=n1*n2*n3*n4
	promedio=suma/4
	Escribir "la suma de los numeros es: ",suma
	Escribir "la multiplicacion de los 4 terminos es: ",multiplicacion
	Escribir "el promedio de los 4 valores es: ",promedio
FinAlgoritmo
